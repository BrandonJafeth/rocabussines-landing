---
// Esta página se renderiza en el servidor (SSR) para obtener datos frescos
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import SectionBlobs from "../components/layout/SectionBlobs.astro";
import ContactForm from "../components/react/ContactForm";
import { getAllActiveServices } from "../lib/queries/services";

const dict = Astro.locals.dict;
const lang = Astro.locals.lang ?? "es";
const services = await getAllActiveServices(lang);
---

<Layout
  title={dict.seo.contact.title}
  description={dict.seo.contact.description}
>
  <main class="bg-white">
    <!-- Hero Section -->
    <section
      class="relative isolate overflow-hidden bg-gradient-to-br from-deepest via-primary to-dark pb-32 pt-32 sm:pt-36 lg:pt-40"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_20%_30%,rgba(255,255,255,0.3),transparent_35%),radial-gradient(circle_at_80%_80%,rgba(255,255,255,0.24),transparent_30%)]"
      >
      </div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <h1
            class="font-heading text-4xl font-bold text-light sm:text-5xl lg:text-6xl"
          >
            {dict.contactPage.heroTitle}
            <span class="block mt-2 text-light">{dict.contactPage.heroTitleSpan}</span>
          </h1>
          <div class="mx-auto mt-6 h-1 w-20 rounded-full bg-dark"></div>
          <p class="mt-6 font-heading text-lg text-light sm:text-xl">
            {dict.contactPage.heroSubtitle}
          </p>
        </div>
      </div>
    </section>

    <!-- Contenido Principal -->
    <section class="-mt-24 pb-20 relative z-10 overflow-hidden">
      <SectionBlobs />
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_380px]">
          <!-- Columna Izquierda: Formulario -->
          <div
            class="rounded-2xl bg-white p-6 sm:p-8 shadow-2xl border border-mid/10"
          >
            <h2 class="font-heading text-2xl font-bold text-deepest mb-2">
              {dict.contactPage.formHeading}
            </h2>
            <p class="font-heading text-sm text-deepest/60 mb-6">
              {dict.contactPage.formSubheading}
            </p>

            <ContactForm client:visible services={services} lang={lang} />
          </div>

          <!-- Columna Derecha: Información de Contacto -->
          <div class="space-y-6">
            <!-- Contacto Directo -->
            <div class="rounded-2xl bg-white p-6 shadow-lg">
              <h3 class="font-heading text-xl font-bold text-deepest mb-4">
                {dict.contactPage.contactDirectTitle}
              </h3>

              <div class="space-y-4">
                <a
                  href="tel:+50670442878"
                  class="flex items-start gap-3 group transition-colors hover:text-primary"
                >
                  <div
                    class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-all"
                  >
                    <svg
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="font-heading text-xs text-deepest/60">{dict.contactPage.phoneLabel}</p>
                    <p
                      class="font-heading text-base font-bold text-deepest group-hover:text-primary transition-colors"
                    >
                      +506 7044-2878
                    </p>
                  </div>
                </a>

                <a
                  href="mailto:asesorias@rocabusiness.net"
                  class="flex items-start gap-3 group transition-colors hover:text-primary"
                >
                  <div
                    class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-all"
                  >
                    <svg
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="font-heading text-xs text-deepest/60">{dict.contactPage.emailLabel}</p>
                    <p
                      class="font-heading text-base font-bold text-deepest group-hover:text-primary transition-colors break-all"
                    >
                      asesorias@rocabusiness.net
                    </p>
                  </div>
                </a>
              </div>

              <div class="mt-6 rounded-lg bg-surface p-4">
                <div class="flex items-start gap-3">
                  <svg
                    class="h-5 w-5 text-primary mt-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 6v6l4 2"></path>
                  </svg>
                  <div>
                    <p class="font-heading text-sm font-bold text-deepest">
                      {dict.contactPage.hoursTitle}
                    </p>
                    <p class="font-heading text-xs text-deepest/70 mt-1">
                      {dict.contactPage.hoursWeekday}
                    </p>
                    <p class="font-heading text-xs text-deepest/70">
                      {dict.contactPage.hoursSaturday}
                    </p>
                    <p class="font-heading text-xs text-deepest/70">
                      {dict.contactPage.hoursSunday}
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- ¿Por Qué Agendar? -->
            <div
              class="rounded-2xl bg-gradient-to-br from-deepest to-primary p-6 shadow-lg text-white"
            >
              <h3 class="font-heading text-xl font-bold mb-4">
                {dict.contactPage.whyTitle}
              </h3>

              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <svg
                    class="h-5 w-5 text-light mt-0.5 flex-shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                  <div>
                    <p class="font-heading text-sm font-bold">
                      {dict.contactPage.why1Title}
                    </p>
                    <p class="font-heading text-xs text-light/80">
                      {dict.contactPage.why1Sub}
                    </p>
                  </div>
                </li>

                <li class="flex items-start gap-3">
                  <svg
                    class="h-5 w-5 text-light mt-0.5 flex-shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                  <div>
                    <p class="font-heading text-sm font-bold">
                      {dict.contactPage.why2Title}
                    </p>
                    <p class="font-heading text-xs text-light/80">
                      {dict.contactPage.why2Sub}
                    </p>
                  </div>
                </li>

                <li class="flex items-start gap-3">
                  <svg
                    class="h-5 w-5 text-light mt-0.5 flex-shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                  <div>
                    <p class="font-heading text-sm font-bold">
                      {dict.contactPage.why3Title}
                    </p>
                    <p class="font-heading text-xs text-light/80">
                      {dict.contactPage.why3Sub}
                    </p>
                  </div>
                </li>

                <li class="flex items-start gap-3">
                  <svg
                    class="h-5 w-5 text-light mt-0.5 flex-shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                  <div>
                    <p class="font-heading text-sm font-bold">
                      {dict.contactPage.why4Title}
                    </p>
                    <p class="font-heading text-xs text-light/80">
                      {dict.contactPage.why4Sub}
                    </p>
                  </div>
                </li>
              </ul>
            </div>

            <!-- Enlaces Rápidos -->
            <div class="rounded-2xl bg-white p-6 shadow-lg">
              <h3 class="font-heading text-xl font-bold text-deepest mb-4">
                {dict.contactPage.quickLinksTitle}
              </h3>

              <ul class="space-y-2">
                <li>
                  <a
                    href="/servicios"
                    class="flex items-center gap-2 font-heading text-sm text-deepest/70 hover:text-primary transition-colors group"
                  >
                    <svg
                      class="h-4 w-4 transition-transform group-hover:translate-x-1"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 5l7 7-7 7"></path>
                    </svg>
                    <span>{dict.contactPage.quickLinkServices}</span>
                  </a>
                </li>
                <li>
                  <a
                    href="/propiedades"
                    class="flex items-center gap-2 font-heading text-sm text-deepest/70 hover:text-primary transition-colors group"
                  >
                    <svg
                      class="h-4 w-4 transition-transform group-hover:translate-x-1"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 5l7 7-7 7"></path>
                    </svg>
                    <span>{dict.contactPage.quickLinkProperties}</span>
                  </a>
                </li>
                <li>
                  <a
                    href="/"
                    class="flex items-center gap-2 font-heading text-sm text-deepest/70 hover:text-primary transition-colors group"
                  >
                    <svg
                      class="h-4 w-4 transition-transform group-hover:translate-x-1"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 5l7 7-7 7"></path>
                    </svg>
                    <span>{dict.contactPage.quickLinkAbout}</span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

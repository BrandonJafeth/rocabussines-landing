---
// Desactivar prerendering para que siempre traiga datos frescos de Supabases
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/home/Hero.astro";
import About from "../components/sections/home/About.astro";
import MissionVision from "../components/sections/home/MissionVision.astro";
import Services from "../components/sections/home/Services.astro";
import FeaturedProperties from "../components/sections/home/FeaturedProperties.astro";
---

<Layout
  title={Astro.locals.dict.seo.home.title}
  description={Astro.locals.dict.seo.home.description}
>
  <main>
    <Hero />
    <FeaturedProperties />
    <About />
    <Services />
    <MissionVision />
    <!-- More sections will be added here -->
  </main>
</Layout>

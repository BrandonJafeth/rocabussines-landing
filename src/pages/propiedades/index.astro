---
// Marcar como server-rendered para leer query params dinámicamente
export const prerender = false;

import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import PropertyFilters from "../../components/react/PropertyFilters";
import { getCatalogProperties } from "../../lib/queries/properties";
import { formatPrice } from "../../utils/formatPrice";
import { getTypeLabel, getStatusLabel, getStatusClass, getSpecLabel, getSpecIcon } from "../../i18n/labels";
import type { PropertyType, HomeFeaturedProperty } from "../../types/property";

const dict = Astro.locals.dict;
const lang = Astro.locals.lang ?? "es";

const typeParam = Astro.url.searchParams.get("tipo");
const provinciaParam = Astro.url.searchParams.get("provincia");
const cantonParam = Astro.url.searchParams.get("canton");
const distritoParam = Astro.url.searchParams.get("distrito");

const validTypes: PropertyType[] = [
  "casa",
  "finca",
  "lote",
  "carro",
  "construccion_en_lote",
];

const selectedType =
  typeParam && validTypes.includes(typeParam as PropertyType)
    ? (typeParam as PropertyType)
    : undefined;

// Limpiar parámetros vacíos o nulos
const cleanProvinciaParam = provinciaParam && provinciaParam.trim() !== "" ? provinciaParam : undefined;
const cleanCantonParam = cantonParam && cantonParam.trim() !== "" ? cantonParam : undefined;
const cleanDistritoParam = distritoParam && distritoParam.trim() !== "" ? distritoParam : undefined;

const properties = await getCatalogProperties(
  {
    provincia: cleanProvinciaParam,
    canton: cleanCantonParam,
    distrito: cleanDistritoParam,
    type: selectedType,
  },
  lang
);
---

<Layout
  title={dict.seo.properties.title}
  description={dict.seo.properties.description}
>
  <Navbar />

  <main class="bg-[#F5F7FA]">
    <section
      class="relative isolate overflow-hidden bg-gradient-to-br from-primary via-deepest to-black pb-28 pt-28  sm:pt-32 lg:pt-36"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-40 bg-[radial-gradient(circle_at_12%_30%,rgba(255,255,255,0.4),transparent_40%),radial-gradient(circle_at_88%_78%,rgba(255,255,255,0.35),transparent_35%)]"
      >
      </div>

      <!-- Capa adicional de degradado para más profundidad -->
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-deepest/50 via-transparent to-transparent">
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <h1
            class="font-heading text-4xl font-bold text-white sm:text-5xl lg:text-6xl"
          >
            {dict.propertiesPage.heroTitle}
          </h1>
          <p class="mt-4 font-heading text-lg text-light/80 sm:text-2xl">
            {dict.propertiesPage.heroSubtitle}
          </p>
        </div>

        <div class="mx-auto mt-10 max-w-5xl">
          <PropertyFilters
            client:load
            initialProvincia={cleanProvinciaParam ?? ""}
            initialCanton={cleanCantonParam ?? ""}
            initialDistrito={cleanDistritoParam ?? ""}
            initialType={selectedType ?? ""}
            lang={lang}
          />
        </div>
      </div>
    </section>

    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {
          properties.length === 0 ? (
            <div class="rounded-2xl border mt-28 border-mid/25 bg-white px-6 py-16 text-center shadow-sm">
              <h2 class="font-heading text-2xl font-bold text-deepest">
                {dict.propertiesPage.noResultsTitle}
              </h2>
              <p class="mt-3 font-heading text-deepest/70">
                {dict.propertiesPage.noResultsText}
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {properties.map((property: HomeFeaturedProperty) => (
                <article class="group relative bg-white rounded-2xl shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl overflow-hidden">
                  <a href={`/propiedades/${property.id}`} class="block">

                    <div class="relative overflow-hidden rounded-t-2xl">
                      <Image
                        src={property.image}
                        alt={`Propiedad: ${property.title}`}
                        width={760}
                        height={560}
                        class="h-56 w-full object-cover transition-all duration-500 group-hover:scale-110"
                        loading="lazy"
                      />

                      <!-- Overlay con gradiente diagonal -->
                      <div class="absolute inset-0 bg-gradient-to-br from-deepest/70 via-transparent to-transparent opacity-40 group-hover:opacity-60 transition-opacity"></div>

                      <!-- Badge de tipo en esquina inferior izquierda -->
                      <div class="absolute bottom-4 left-4">
                        <span class="inline-block bg-white/95 backdrop-blur-sm px-3 py-1.5 text-xs font-heading font-bold text-deepest shadow-lg rounded-full">
                          {getTypeLabel(property.type, lang)}
                        </span>
                      </div>
                    </div>

                    <div class="p-5">
                      <!-- Precio destacado arriba -->
                      <div class="flex items-baseline justify-between gap-2 mb-3">
                        <div>
                        <span class="font-heading text-3xl font-extrabold text-primary leading-none">
                          {formatPrice(property.price, property.currency)}
                        </span>
                        <span class="text-xs font-heading text-deepest/50 uppercase tracking-wide">{dict.propertiesPage.since}</span>
                        </div>
                          <span class={`inline-block px-3 py-1.5 text-xs font-heading font-bold shadow-lg rounded-full ${getStatusClass(property.status)}`}>
                        {getStatusLabel(property.status, lang)}
                      </span>
                      </div>

                      <h2 class="line-clamp-2 min-h-[3rem] font-heading text-lg font-bold text-deepest leading-snug">
                        {property.title}
                      </h2>

                      <!-- Ubicación completa -->
                      <div class="flex items-start gap-1.5 text-xs font-heading text-deepest/60 mb-4">
                        <svg
                          class="h-3.5 w-3.5 flex-shrink-0 mt-0.5 text-primary"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 21s-7-4.35-7-11a7 7 0 1114 0c0 6.65-7 11-7 11z"
                          />
                          <circle cx="12" cy="10" r="2.5" stroke-width="2" />
                        </svg>
                        <span class="line-clamp-2 leading-tight">{property.location}</span>
                      </div>

                      <!-- Características en grid flexible -->
                      <div class="flex items-center justify-center flex-wrap gap-3 pb-4 border-b border-mid/20">
                        {property.details.map(
                          (detail: { key: string; value: string }) => (
                            <div class="flex flex-col items-center flex-1 min-w-0">
                              <div class="mb-1">
                                {getSpecIcon(detail.key) === "bed" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M3 9v6h18V9M3 15v3M21 15v3M7 9V6a2 2 0 012-2h6a2 2 0 012 2v3"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.key) === "bath" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M4 13h16M7 13V9a2 2 0 114 0v4M4 13v2a4 4 0 004 4h8a4 4 0 004-4v-2"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.key) === "area" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.key) === "calendar" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.key) === "speedometer" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.key) === "gear" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M12 9a3 3 0 100 6 3 3 0 000-6zm7.4 3a7.4 7.4 0 01-.1 1l2.1 1.6-2 3.5-2.5-1a7.7 7.7 0 01-1.7 1l-.4 2.7h-4l-.4-2.7a7.7 7.7 0 01-1.7-1l-2.5 1-2-3.5 2.1-1.6a7.4 7.4 0 010-2L2.6 9.4l2-3.5 2.5 1a7.7 7.7 0 011.7-1l.4-2.7h4l.4 2.7a7.7 7.7 0 011.7 1l2.5-1 2 3.5-2.1 1.6a7.4 7.4 0 01.1 1z"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.key) === "map" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.key) === "location" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    />
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.key) === "default" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                    />
                                  </svg>
                                )}
                              </div>
                              <p class="font-heading text-sm font-bold text-deepest truncate w-full text-center">
                                {detail.value}
                              </p>
                              <p class="text-[10px] font-heading text-deepest/50 truncate w-full text-center uppercase tracking-wide">
                                {getSpecLabel(detail.key, lang)}
                              </p>
                            </div>
                          ),
                        )}
                      </div>

                      <!-- CTA con flecha -->
                      <div class="mt-4 flex items-center justify-between group/cta">
                        <span class="font-heading text-sm text-deepest font-semibold group-hover:text-primary transition-colors">
                          {dict.propertiesPage.viewDetails}
                        </span>
                        <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white transition-all duration-300 group-hover:bg-deepest group-hover:scale-110 group-hover:rotate-45">
                          <svg
                            class="h-5 w-5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M7 17L17 7M17 7H7M17 7v10"
                            />
                          </svg>
                        </div>
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>
</Layout>

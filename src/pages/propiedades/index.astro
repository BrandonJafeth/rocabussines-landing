---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import PropertyFilters from "../../components/react/PropertyFilters";
import { getCatalogProperties } from "../../lib/queries/properties";
import { formatPrice } from "../../utils/formatPrice";
import type { PropertyType, HomeFeaturedProperty } from "../../types/property";

const typeParam = Astro.url.searchParams.get("tipo");
const locationParam = Astro.url.searchParams.get("ubicacion") ?? "";

const validTypes: PropertyType[] = [
  "casa",
  "finca",
  "lote",
  "carro",
  "construccion_en_lote",
];

const selectedType =
  typeParam && validTypes.includes(typeParam as PropertyType)
    ? (typeParam as PropertyType)
    : undefined;

const properties = await getCatalogProperties({
  location: locationParam || undefined,
  type: selectedType,
});

function getTypeLabel(type: PropertyType): string {
  if (type === "construccion_en_lote") return "Construcción";
  return type.charAt(0).toUpperCase() + type.slice(1);
}

function getStatusLabel(status: string): string {
  if (status === "vendido") return "Vendida";
  if (status === "pendiente_revision") return "Pendiente";
  if (status === "inactivo") return "Inactiva";
  return "Activa";
}

function getStatusClass(status: string): string {
  if (status === "vendido") return "bg-[#E3B83A] text-deepest";
  if (status === "pendiente_revision") return "bg-mid/40 text-deepest";
  if (status === "inactivo") return "bg-deepest/70 text-white";
  return "bg-[#2D9E6B] text-white";
}

function getSpecIcon(label: string) {
  const normalizedLabel = label
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");

  if (normalizedLabel === "hab" || normalizedLabel === "habitaciones")
    return "bed";
  if (normalizedLabel === "banos" || normalizedLabel === "baños") return "bath";
  if (normalizedLabel === "area" || normalizedLabel === "m2") return "area";
  if (normalizedLabel === "ano" || normalizedLabel === "año") return "calendar";
  if (normalizedLabel === "transmision" || normalizedLabel === "transmisión")
    return "gear";
  if (normalizedLabel === "kilometraje" || normalizedLabel === "km")
    return "speedometer";
  return "default";
}
---

<Layout
  title="Catálogo de Propiedades | Roca Business"
  description="Explora nuestro catálogo de propiedades disponibles en Costa Rica y filtra por ubicación o tipo para encontrar la opción ideal."
>
  <Navbar />

  <main class="bg-[#F5F7FA]">
    <section
      class="relative isolate overflow-hidden bg-gradient-to-br from-deepest via-primary to-dark pb-24 pt-32 sm:pt-36 lg:pt-40"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_20%_30%,rgba(255,255,255,0.3),transparent_35%),radial-gradient(circle_at_80%_80%,rgba(255,255,255,0.24),transparent_30%)]"
      >
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <h1
            class="font-heading text-4xl font-bold text-white sm:text-5xl lg:text-6xl"
          >
            Propiedades Disponibles
          </h1>
          <p class="mt-4 font-heading text-lg text-light/80 sm:text-2xl">
            Encuentra la propiedad perfecta para ti
          </p>
        </div>

        <div class="mx-auto mt-10 max-w-5xl">
          <PropertyFilters
            client:load
            initialLocation={locationParam}
            initialType={selectedType ?? ""}
          />
        </div>
      </div>
    </section>

    <section class="-mt-10 pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {
          properties.length === 0 ? (
            <div class="rounded-2xl border border-mid/25 bg-white px-6 py-16 text-center shadow-sm">
              <h2 class="font-heading text-2xl font-bold text-deepest">
                No encontramos propiedades con esos filtros
              </h2>
              <p class="mt-3 font-heading text-deepest/70">
                Intenta cambiar la ubicación o seleccionar otro tipo de
                propiedad.
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {properties.map((property: HomeFeaturedProperty) => (
                <article class="group overflow-hidden rounded-2xl bg-white shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                  <a href={`/propiedades/${property.id}`} class="block">
                    <div class="relative overflow-hidden rounded-t-2xl">
                      <Image
                        src={property.image}
                        alt={`Propiedad: ${property.title}`}
                        width={760}
                        height={560}
                        class="h-56 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />

                      <span class="absolute left-4 top-4 rounded-full bg-white px-3 py-1 text-sm font-heading font-bold text-deepest shadow-sm">
                        {getTypeLabel(property.type)}
                      </span>

                      <span
                        class={`absolute right-4 top-4 rounded-full px-3 py-1 text-sm font-heading font-bold shadow-sm ${getStatusClass(
                          property.status,
                        )}`}
                      >
                        {getStatusLabel(property.status)}
                      </span>
                    </div>

                    <div class="p-5">
                      <h2 class="line-clamp-2 font-heading text-xl sm:text-2xl font-bold text-deepest">
                        {property.title}
                      </h2>

                      <div class="mt-3 flex items-center gap-2 text-sm font-heading text-deepest/55">
                        <svg
                          class="h-4 w-4"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 21s-7-4.35-7-11a7 7 0 1114 0c0 6.65-7 11-7 11z"
                          />
                          <circle cx="12" cy="10" r="2.5" stroke-width="2" />
                        </svg>
                        <span>{property.location}</span>
                      </div>

                      <div class="mt-5 grid grid-cols-3 gap-2">
                        {property.details.map(
                          (detail: { label: string; value: string }) => (
                            <div class="flex flex-col items-center justify-center rounded-lg bg-primary/10 border border-primary/20 p-3 text-center shadow-sm">
                              {getSpecIcon(detail.label) === "bed" && (
                                <svg
                                  class="h-6 w-6 text-primary"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 7v10M3 13h18M7 13v-3h4v3M13 13V9h4a3 3 0 013 3v1"
                                  />
                                </svg>
                              )}
                              {getSpecIcon(detail.label) === "bath" && (
                                <svg
                                  class="h-6 w-6 text-primary"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 13h16M7 13V9a2 2 0 114 0v4M4 13v2a4 4 0 004 4h8a4 4 0 004-4v-2"
                                  />
                                </svg>
                              )}
                              {getSpecIcon(detail.label) === "area" && (
                                <svg
                                  class="h-6 w-6 text-primary"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
                                  />
                                </svg>
                              )}
                              {getSpecIcon(detail.label) === "calendar" && (
                                <svg
                                  class="h-6 w-6 text-primary"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"
                                  />
                                </svg>
                              )}
                              {getSpecIcon(detail.label) === "speedometer" && (
                                <svg
                                  class="h-6 w-6 text-primary"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                  />
                                </svg>
                              )}
                              {getSpecIcon(detail.label) === "gear" && (
                                <svg
                                  class="h-6 w-6 text-primary"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 9a3 3 0 100 6 3 3 0 000-6zm7.4 3a7.4 7.4 0 01-.1 1l2.1 1.6-2 3.5-2.5-1a7.7 7.7 0 01-1.7 1l-.4 2.7h-4l-.4-2.7a7.7 7.7 0 01-1.7-1l-2.5 1-2-3.5 2.1-1.6a7.4 7.4 0 010-2L2.6 9.4l2-3.5 2.5 1a7.7 7.7 0 011.7-1l.4-2.7h4l.4 2.7a7.7 7.7 0 011.7 1l2.5-1 2 3.5-2.1 1.6a7.4 7.4 0 01.1 1z"
                                  />
                                </svg>
                              )}
                              {getSpecIcon(detail.label) === "default" && (
                                <svg
                                  class="h-6 w-6 text-primary"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                  />
                                </svg>
                              )}
                              <p class="mt-2 font-heading text-sm font-bold text-deepest">
                                {detail.value}
                              </p>
                              <p class="mt-0.5 text-xs font-heading text-deepest/50">
                                {detail.label}
                              </p>
                            </div>
                          ),
                        )}
                      </div>

                      <div class="mt-5 h-px w-full bg-mid/30" />

                      <div class="mt-4 flex items-end justify-between">
                        <div>
                          <p class="font-heading text-sm text-deepest/45">
                            Precio
                          </p>
                          <p class="font-heading text-2xl sm:text-3xl font-extrabold text-deepest">
                            {formatPrice(property.price, property.currency)}
                          </p>
                        </div>

                        <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white transition-all duration-300 group-hover:bg-deepest">
                          <svg
                            class="h-5 w-5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 12h14m-6-6l6 6-6 6"
                            />
                          </svg>
                        </div>
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>
</Layout>

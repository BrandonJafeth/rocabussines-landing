---
// Esta página se renderiza en el servidor (SSR) para obtener datos frescos de Supabase
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import { getAllActiveServices } from "../lib/queries/services";
import type { HomeService } from "../types/service";

const services = await getAllActiveServices();

function getIconSvg(icon: HomeService["icon"]) {
  const icons = {
    chart: `<svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
    </svg>`,
    document: `<svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>`,
    currency: `<svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`,
    building: `<svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
    </svg>`,
    users: `<svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
    </svg>`,
  };
  return icons[icon] || icons.building;
}

// Función para asignar tamaños variados en el bento grid
function getGridClass(index: number, total: number): string {
  // Para 5 servicios o menos, usar patrón específico
  if (total <= 5) {
    if (index === 0) return "lg:col-span-2 lg:row-span-1"; // Primera: ancha
    if (index === 1) return "lg:col-span-1 lg:row-span-1"; // Segunda: normal
    return "lg:col-span-1 lg:row-span-1"; // Resto: normales
  }

  // Para más servicios, usar patrón repetitivo organizado
  const patterns = [
    "lg:col-span-2 lg:row-span-1", // Ancha
    "lg:col-span-1 lg:row-span-1", // Normal
    "lg:col-span-1 lg:row-span-1", // Normal
    "lg:col-span-1 lg:row-span-1", // Normal
    "lg:col-span-2 lg:row-span-1", // Ancha
    "lg:col-span-1 lg:row-span-1", // Normal
  ];
  return patterns[index % patterns.length];
}
---

<Layout
  title="Servicios Profesionales | Roca Business"
  description="Descubre nuestro portafolio completo de servicios especializados diseñados para impulsar tu crecimiento y maximizar tus resultados."
>
  <main class="bg-white">
    <!-- Hero Section -->
    <section
      class="relative isolate overflow-hidden from-deepest via-primary to-dark pb-24 pt-32 sm:pt-36 lg:pt-40"
    >
      <div class="pointer-events-none absolute inset-0 opacity-20 bg-blue">
      </div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <h1
            class="font-heading text-4xl font-bold text-blue sm:text-5xl lg:text-6xl"
          >
            Soluciones Integrales
            <span class="block mt-2 text-blue">para tu Éxito</span>
          </h1>
          <div class="mx-auto mt-6 h-1 w-20 rounded-full bg-dark"></div>
          <p class="mt-6 font-heading text-lg text-blue sm:text-xl">
            Ofrecemos un portafolio completo de servicios especializados
            diseñados para impulsar tu crecimiento y maximizar tus resultados
          </p>
        </div>
      </div>
    </section>

    <!-- Bento Grid de Servicios -->
    <section class="-mt-16 pb-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {
          services.length === 0 ? (
            <div class="rounded-2xl border border-mid/25 bg-white px-6 py-16 text-center shadow-sm">
              <h2 class="font-heading text-2xl font-bold text-deepest">
                Próximamente
              </h2>
              <p class="mt-3 font-heading text-deepest/70">
                Estamos preparando nuestro catálogo de servicios.
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:auto-rows-[300px]">
              {services.map((service, index) => (
                <article
                  class={`group relative overflow-hidden rounded-2xl bg-white border border-mid/20 p-6 lg:p-8 shadow-md transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:border-primary/40 ${getGridClass(index, services.length)}`}
                >
                  <div class="relative flex h-full flex-col justify-between">
                    <div>
                      <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10 transition-all duration-300 group-hover:bg-primary/20 group-hover:scale-110">
                        <div
                          class="text-primary"
                          set:html={getIconSvg(service.icon)}
                        />
                      </div>

                      <h2 class="font-heading text-xl lg:text-2xl font-bold text-deepest mb-3 line-clamp-2">
                        {service.title}
                      </h2>

                      <p class="font-heading text-sm text-deepest/70 leading-relaxed">
                        {service.description}
                      </p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )
        }
      </div>
      <div
        class="relative mx-auto max-w-4xl mt-16 px-4 text-center sm:px-6 lg:px-8"
      >
        <h2 class="font-heading text-3xl font-bold text-blue sm:text-4xl">
          ¿Necesitas asesoría personalizada?
        </h2>
        <p class="mt-4 font-heading text-lg text-blue/90">
          Contáctanos y descubre cómo podemos ayudarte a alcanzar tus objetivos
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:justify-center">
          <a
            href="/contacto"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-dark px-8 py-4 font-heading text-base font-bold text-light shadow-lg transition-all hover:bg-blue/20 hover:shadow-xl hover:scale-105"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>Contáctanos</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

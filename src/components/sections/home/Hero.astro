---
// Hero component for the landing page
import LoaderSplitText from "../../react/LoaderSplitText";
---

<!-- Page loader overlay -->
<div
  class="page-loader fixed inset-0 z-[9999] bg-gradient-to-br from-deepest via-deepest to-dark flex items-center justify-center"
>
  <div class="loader-content text-center">
    <LoaderSplitText client:load className="-mt-2" />
  </div>
</div>

<section
  id="hero"
  class="relative min-h-[80vh] flex items-center justify-center overflow-hidden bg-white"
>
  <!-- Background Video with Overlay -->
  <div class="absolute inset-0 z-0">
    <!-- Gradient overlay for better text readability -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-deepest/45 via-deepest/40 to-deepest/55 z-10"
    >
    </div>
    <!-- Optimized background video -->
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="https://res.cloudinary.com/dkwvaxxdw/video/upload/f_auto,w_1920,q_auto,so_0s/v1780258701/roca-hero_ncrzee.jpg"
      class="absolute inset-0 w-full h-full object-cover"
    >
      <source
        src="https://res.cloudinary.com/dkwvaxxdw/video/upload/f_auto,q_auto:best,w_1920,h_1080,c_fill/v1780258701/roca-hero_ncrzee.mp4"
        type="video/mp4"
      />
      <!-- Fallback image -->
      <img
        src="https://res.cloudinary.com/dkwvaxxdw/video/upload/f_auto,w_1920,q_auto,so_0s/v1780258701/roca-hero_ncrzee.jpg"
        alt="Hero background - Roca Business"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </video>
  </div>

  <!-- Content Container -->
  <div
    class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center"
  >
    <!-- Main Content with animations -->
    <div class="hero-content space-y-8">
      <!-- Main Heading -->
      <h1
        class="hero-title text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-bold tracking-tight leading-tight"
      >
        <span class="block text-white">Bienes Raíces en Guanacaste,</span>
        <span class="block text-mid mt-2">creamos tu futuro</span>
      </h1>

      <!-- Subtitle -->
      <p
        class="hero-subtitle text-lg sm:text-xl md:text-2xl text-light/90 max-w-3xl mx-auto font-heading"
      >
        Construimos confianza — asesoría experta en compra, venta e inversión
        de propiedades en Liberia, Guanacaste y toda Costa Rica.
      </p>

      <!-- CTA Button (Scroll to next section) -->
      <div class="hero-cta pt-4">
        <button
          id="hero-scroll-btn"
          type="button"
          class="inline-flex items-center gap-3 px-8 py-4 bg-transparent border-2 border-light text-light font-heading text-lg rounded-lg transition-all duration-300 hover:bg-light hover:text-deepest hover:shadow-2xl hover:scale-105 hover:border-light"
          aria-label="Explorar secciones"
        >
          <span>Explorar</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="btn-arrow w-5 h-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
      </div>

      <script>
        (function () {
          const btn = document.getElementById("hero-scroll-btn");
          if (!btn) return;
          btn.addEventListener("click", function () {
            const hero = document.getElementById("hero");
            const target = hero && hero.nextElementSibling;
            if (target) {
              target.scrollIntoView({ behavior: "smooth", block: "start" });
            } else {
              window.scrollBy({
                top: window.innerHeight * 0.9,
                left: 0,
                behavior: "smooth",
              });
            }
          });
        })();
      </script>
    </div>
  </div>
  <!-- Decorative wave separator -->
  <div
    class="absolute -bottom-px left-0 right-0 z-20 leading-none pointer-events-none overflow-hidden"
  >
    <svg
      viewBox="0 0 1440 120"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="block w-full h-auto translate-y-px"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M0 124L60 111C120 101 240 81 360 71C480 61 600 61 720 66C840 71 960 81 1080 86C1200 91 1320 91 1380 91L1440 91V121H1380C1320 121 1200 121 1080 121C960 121 840 121 720 121C600 121 480 121 360 121C240 121 120 121 60 121H0Z"
        fill="#ffffff"></path>
    </svg>
  </div>
</section>

<style>
  /* Page loader animations */
  @keyframes logoFade {
    0% {
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes loaderFadeOut {
    0% {
      opacity: 1;
      visibility: visible;
    }
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  .page-loader {
    animation: loaderFadeOut 0.6s ease-out 2s forwards;
  }

  .animate-logo-fade {
    animation: logoFade 1.2s cubic-bezier(0.22, 0.03, 0.26, 1) forwards;
  }

  /* Fade in and slide up animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(60px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Hero title animation with stagger effect on spans - start after loader */
  .hero-title span {
    display: block;
    opacity: 0;
  }

  .hero-title span:first-child {
    animation: fadeInUp 1s cubic-bezier(0.22, 0.03, 0.26, 1) 2.2s both;
  }

  .hero-title span:last-child {
    animation: fadeInUp 1s cubic-bezier(0.22, 0.03, 0.26, 1) 2.4s both;
  }

  /* Subtitle animation */
  .hero-subtitle {
    opacity: 0;
    animation: fadeInUp 0.9s cubic-bezier(0.22, 0.03, 0.26, 1) 2.7s both;
  }

  /* CTA button animation */
  .hero-cta {
    opacity: 0;
    animation: fadeInScale 0.8s cubic-bezier(0.22, 0.03, 0.26, 1) 3.1s both;
  }

  /* Scroll indicator animation */
  .hero-scroll {
    opacity: 0;
    animation: fadeInUp 0.7s ease-out 6s both;
  }

  /* Smooth transitions for hover effects */
  .hero-cta a {
    position: relative;
    overflow: hidden;
  }

  .hero-cta a::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(238, 244, 237, 0.1);
    transform: translate(-50%, -50%);
    transition:
      width 0.6s ease,
      height 0.6s ease;
  }

  .hero-cta a:hover::before {
    width: 300px;
    height: 300px;
  }

  /* Arrow bounce animation for CTA */
  @keyframes bounceArrow {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-6px);
    }
    60% {
      transform: translateY(-3px);
    }
  }

  .btn-arrow {
    display: inline-block;
    animation: bounceArrow 1.8s infinite;
    will-change: transform;
  }
</style>

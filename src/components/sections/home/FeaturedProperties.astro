---
import { Image } from "astro:assets";
import { getFeaturedProperties } from "../../../lib/queries/properties";
import { formatPrice } from "../../../utils/formatPrice";
import type {
  HomeFeaturedProperty,
  PropertyType,
} from "../../../types/property";

function getTypeLabel(type: PropertyType): string {
  if (type === "construccion_en_lote") return "Construcción";
  return type.charAt(0).toUpperCase() + type.slice(1);
}

function getStatusLabel(status: string): string {
  if (status === "vendido") return "Vendida";
  if (status === "pendiente_revision") return "Pendiente";
  if (status === "inactivo") return "Inactiva";
  return "Activa";
}

function getStatusClass(status: string): string {
  if (status === "vendido") return "bg-[#E3B83A] text-deepest";
  if (status === "pendiente_revision") return "bg-mid/40 text-deepest";
  if (status === "inactivo") return "bg-deepest/70 text-white";
  return "bg-[#2D9E6B] text-white";
}

function getSpecIcon(label: string): string {
  const normalizedLabel = label
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");

  if (normalizedLabel === "hab") return "bed";
  if (normalizedLabel === "banos") return "bath";
  if (normalizedLabel === "area") return "area";
  if (normalizedLabel === "ano") return "calendar";
  if (normalizedLabel === "transmision") return "gear";
  if (normalizedLabel === "kilometraje") return "road";
  return "";
}

const propertiesFromDb = await getFeaturedProperties(3);
const properties = propertiesFromDb.length > 0 ? propertiesFromDb : [];
---

<section id="propiedades" class="py-20 bg-white scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold text-deepest"
      >
        Propiedades Destacadas
      </h2>
      <div class="w-20 h-1 bg-primary rounded-full mx-auto mt-4 mb-6"></div>
      <p class="text-deepest/75 font-heading text-base sm:text-lg">
        Explorá nuestras propiedades más relevantes para inversión y vivienda en
        ubicaciones estratégicas de Costa Rica.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 xl:gap-8">
      {
        properties.map((property) => (
          <article class="group overflow-hidden rounded-2xl border border-mid/30 bg-white shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="relative overflow-hidden rounded-t-2xl">
              <Image
                src={property.image}
                alt={`Propiedad destacada: ${property.title}`}
                width={720}
                height={540}
                class="h-52 w-full object-cover"
                loading="lazy"
              />
              <span class="absolute left-4 top-4 rounded-full bg-white px-3 py-1 text-sm font-heading font-bold text-deepest shadow-sm">
                {getTypeLabel(property.type)}
              </span>
            </div>

            <div class="p-5">
              <h3 class="font-body text-xl font-extrabold line-clamp-2">
                {property.title}
              </h3>

              <div class="mt-3 flex items-center gap-2 text-sm text-deepest/55 font-heading line-clamp-1">
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 21s-7-4.35-7-11a7 7 0 1114 0c0 6.65-7 11-7 11z"
                  />
                  <circle cx="12" cy="10" r="2.5" stroke-width="2" />
                </svg>
                <span>{property.location}</span>
              </div>

              <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-deepest/80 font-heading">
                {property.details.map((detail) => (
                  <div class="inline-flex items-center gap-2">
                    {getSpecIcon(detail.label) === "bed" && (
                      <svg
                        class="h-4 w-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 7v10M3 13h18M7 13v-3h4v3M13 13V9h4a3 3 0 013 3v1"
                        />
                      </svg>
                    )}
                    {getSpecIcon(detail.label) === "bath" && (
                      <svg
                        class="h-4 w-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M4 13h16M7 13V9a2 2 0 114 0v4M4 13v2a4 4 0 004 4h8a4 4 0 004-4v-2"
                        />
                      </svg>
                    )}
                    {getSpecIcon(detail.label) === "area" && (
                      <svg
                        class="h-4 w-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
                        />
                      </svg>
                    )}
                    {getSpecIcon(detail.label) === "calendar" && (
                      <svg
                        class="h-4 w-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"
                        />
                      </svg>
                    )}
                    {getSpecIcon(detail.label) === "road" && (
                      <svg
                        class="h-4 w-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.5"
                          d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                        />
                      </svg>
                    )}
                    {getSpecIcon(detail.label) === "gear" && (
                      <svg
                        class="h-4 w-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 9a3 3 0 100 6 3 3 0 000-6zm7.4 3a7.4 7.4 0 01-.1 1l2.1 1.6-2 3.5-2.5-1a7.7 7.7 0 01-1.7 1l-.4 2.7h-4l-.4-2.7a7.7 7.7 0 01-1.7-1l-2.5 1-2-3.5 2.1-1.6a7.4 7.4 0 010-2L2.6 9.4l2-3.5 2.5 1a7.7 7.7 0 011.7-1l.4-2.7h4l.4 2.7a7.7 7.7 0 011.7 1l2.5-1 2 3.5-2.1 1.6a7.4 7.4 0 01.1 1z"
                        />
                      </svg>
                    )}
                    <span>{detail.value}</span>
                  </div>
                ))}
              </div>

              <div class="mt-5 h-px w-full bg-mid/30" />

              <div class="mt-4 flex items-end justify-between">
                <div>
                  <p class="font-heading text-sm text-deepest/45">Precio</p>
                  <p class="font-heading text-[1.50rem] leading-none font-bold text-deepest mt-1">
                    {formatPrice(property.price, property.currency)}
                  </p>
                </div>
                <a
                  href={`/propiedades/${property.id}`}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white shadow-md transition-colors hover:bg-deepest"
                  aria-label={`Ver detalle de ${property.title}`}
                >
                  <svg
                    class="h-3 w-3"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href="/propiedades"
        class="inline-flex items-center justify-center px-7 py-3 rounded-xl bg-primary text-white font-heading font-semibold tracking-wide transition-colors duration-300 hover:bg-deepest"
      >
        Ver más Propiedades
      </a>
    </div>
  </div>
</section>

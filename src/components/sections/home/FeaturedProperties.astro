---
import { Image } from "astro:assets";
import { getFeaturedProperties } from "../../../lib/queries/properties";
import { formatPrice } from "../../../utils/formatPrice";
import type {
  PropertyType,
} from "../../../types/property";

function getTypeLabel(type: PropertyType): string {
  if (type === "construccion_en_lote") return "Construcción";
  return type.charAt(0).toUpperCase() + type.slice(1);
}

function getStatusLabel(status: string): string {
  if (status === "vendido") return "Vendida";
  if (status === "pendiente_revision") return "Pendiente";
  if (status === "inactivo") return "Inactiva";
  return "Activa";
}

function getStatusClass(status: string): string {
  if (status === "vendido") return "bg-[#E3B83A] text-deepest";
  if (status === "pendiente_revision") return "bg-mid/40 text-deepest";
  if (status === "inactivo") return "bg-deepest/70 text-white";
  return "bg-[#2D9E6B] text-white";
}

function getSpecIcon(label: string): string {
  const normalizedLabel = label
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");

  if (normalizedLabel === "hab" || normalizedLabel === "habitaciones") return "bed";
  if (normalizedLabel === "banos" || normalizedLabel === "baños") return "bath";
  if (normalizedLabel === "area" || normalizedLabel === "m2") return "area";
  if (normalizedLabel === "hectareas") return "area"; // Usar mismo icono que área
  if (normalizedLabel === "ano" || normalizedLabel === "año") return "calendar";
  if (normalizedLabel === "transmision" || normalizedLabel === "transmisión") return "gear";
  if (normalizedLabel === "kilometraje" || normalizedLabel === "km") return "speedometer";
  if (normalizedLabel === "zonificacion") return "map";
  if (normalizedLabel === "distrito") return "location";
  return "default";
}

// Ya no limitamos a 3, traemos todas las destacadas
const propertiesFromDb = await getFeaturedProperties(12); // Fetches up to 12 featured properties, but you can remove the limit if you want *all*
const properties = propertiesFromDb.length > 0 ? propertiesFromDb : [];
---

<section id="propiedades" class="py-20 bg-white scroll-mt-28 relative">
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold text-deepest"
      >
        Propiedades Destacadas
      </h2>
      <div class="w-20 h-1 bg-primary rounded-full mx-auto mt-4 mb-6"></div>
      <p class="text-deepest/75 font-heading text-base sm:text-lg">
        Explorá nuestras propiedades más relevantes para inversión y vivienda en
        ubicaciones estratégicas de Costa Rica.
      </p>
    </div>

    <!-- Contenedor del Carrusel -->
    <div class="relative px-0 sm:px-12 lg:px-16"> 
      
      <!-- Botón Anterior (Solo Desktop) -->
      <button 
        id="prevBtn" 
        class="hidden sm:flex absolute left-0 top-[40%] -translate-y-1/2 z-10 w-10 h-10 lg:w-12 lg:h-12 bg-white border border-primary/10 rounded-full shadow-[0_4px_15px_-4px_rgba(0,0,0,0.15)] items-center justify-center text-primary hover:bg-primary hover:text-white hover:scale-110 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-white disabled:hover:text-primary disabled:hover:scale-100"
        aria-label="Anterior propiedad"
      >
        <svg class="w-5 h-5 lg:w-6 lg:h-6 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>

      <!-- Botón Siguiente (Solo Desktop) -->
      <button 
        id="nextBtn" 
        class="hidden sm:flex absolute right-0 top-[40%] -translate-y-1/2 z-10 w-10 h-10 lg:w-12 lg:h-12 bg-white border border-primary/10 rounded-full shadow-[0_4px_15px_-4px_rgba(0,0,0,0.15)] items-center justify-center text-primary hover:bg-primary hover:text-white hover:scale-110 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-white disabled:hover:text-primary disabled:hover:scale-100"
        aria-label="Siguiente propiedad"
      >
        <svg class="w-5 h-5 lg:w-6 lg:h-6 mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>

      <!-- Lista deslizable (Snap scrolling en móvil, normal / js scroll en desktop) -->
      <div 
        id="slider" 
        class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-12 pt-4 px-4 sm:px-0 -mx-4 sm:mx-0 scrollbar-hide scroll-smooth"
      >
        {
          properties.map((property) => (
            <!-- Ajuste del ancho de la card para que funcione bien en el scroll layout -->
            <article class="snap-start snap-always flex-none w-[85vw] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)] group relative bg-white rounded-2xl shadow-[0_4px_20px_-10px_rgba(0,0,0,0.1)] transition-all duration-300 hover:shadow-[0_15px_30px_-10px_rgba(19,64,116,0.3)] overflow-hidden">
                    <a href={`/propiedades/${property.id}`} class="flex h-full flex-col">

                    <div class="relative overflow-hidden rounded-t-2xl">
                      <Image
                        src={property.image}
                        alt={`Propiedad: ${property.title}`}
                        width={760}
                        height={560}
                        class="h-56 w-full object-cover transition-all duration-500 group-hover:scale-110"
                        loading="lazy"
                      />
                      
                      <!-- Overlay con gradiente diagonal -->
                      <div class="absolute inset-0 bg-gradient-to-br from-deepest/70 via-transparent to-transparent opacity-40 group-hover:opacity-60 transition-opacity"></div>

                      <!-- Badge de tipo en esquina inferior izquierda -->
                      <div class="absolute bottom-4 left-4">
                        <span class="inline-block bg-white/95 backdrop-blur-sm px-3 py-1.5 text-xs font-heading font-bold text-deepest shadow-lg rounded-full">
                          {getTypeLabel(property.type)}
                        </span>
                      </div>
                    </div>

                    <div class="p-5">
                      <!-- Precio destacado arriba -->
                             <div class="flex items-baseline justify-between gap-2 mb-3">
                        <div>
                        <span class="font-heading text-3xl font-extrabold text-primary leading-none">
                          {formatPrice(property.price, property.currency)}
                        </span>
                       </div>
                          <span class={`inline-block px-3 py-1.5 text-xs font-heading font-bold shadow-lg rounded-full ${getStatusClass(property.status)}`}>
                        {getStatusLabel(property.status)}
                      </span>
                      </div>

                      <h2 class="line-clamp-2 min-h-[3rem] font-heading text-lg font-bold text-deepest leading-snug mb-2">
                        {property.title}
                      </h2>

                      <!-- Ubicación completa -->
                      <div class="flex items-start gap-1.5 text-xs font-heading text-deepest/60 mb-4">
                        <svg
                          class="h-3.5 w-3.5 flex-shrink-0 mt-0.5 text-primary"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 21s-7-4.35-7-11a7 7 0 1114 0c0 6.65-7 11-7 11z"
                          />
                          <circle cx="12" cy="10" r="2.5" stroke-width="2" />
                        </svg>
                        <span class="line-clamp-2 leading-tight">{property.location}</span>
                      </div>

                      <!-- Características en grid flexible -->
                      <div class="flex items-center justify-center flex-wrap gap-3 pb-4 border-b border-mid/20">
                        {property.details.map(
                          (detail: { label: string; value: string }) => (
                            <div class="flex flex-col items-center flex-1 min-w-0">
                              <div class="mb-1">
                                {getSpecIcon(detail.label) === "bed" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M3 9v6h18V9M3 15v3M21 15v3M7 9V6a2 2 0 012-2h6a2 2 0 012 2v3"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.label) === "bath" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M4 13h16M7 13V9a2 2 0 114 0v4M4 13v2a4 4 0 004 4h8a4 4 0 004-4v-2"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.label) === "area" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.label) === "calendar" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.label) === "speedometer" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.label) === "gear" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M12 9a3 3 0 100 6 3 3 0 000-6zm7.4 3a7.4 7.4 0 01-.1 1l2.1 1.6-2 3.5-2.5-1a7.7 7.7 0 01-1.7 1l-.4 2.7h-4l-.4-2.7a7.7 7.7 0 01-1.7-1l-2.5 1-2-3.5 2.1-1.6a7.4 7.4 0 010-2L2.6 9.4l2-3.5 2.5 1a7.7 7.7 0 011.7-1l.4-2.7h4l.4 2.7a7.7 7.7 0 011.7 1l2.5-1 2 3.5-2.1 1.6a7.4 7.4 0 01.1 1z"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.label) === "map" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.label) === "location" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    />
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    />
                                  </svg>
                                )}
                                {getSpecIcon(detail.label) === "default" && (
                                  <svg
                                    class="h-5 w-5 text-primary"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                    />
                                  </svg>
                                )}
                              </div>
                              <p class="font-heading text-sm font-bold text-deepest truncate w-full text-center">
                                {detail.value}
                              </p>
                              <p class="text-[10px] font-heading text-deepest/50 truncate w-full text-center uppercase tracking-wide">
                                {detail.label}
                              </p>
                            </div>
                          ),
                        )}
                      </div>

                      <!-- CTA con flecha -->
                      <div class="mt-4 flex items-center justify-between group/cta">
                        <span class="font-heading text-sm text-deepest font-semibold group-hover:text-primary transition-colors">
                          Ver detalles
                        </span>
                        <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white transition-all duration-300 group-hover:bg-deepest group-hover:scale-110 group-hover:rotate-45">
                          <svg
                            class="h-5 w-5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M7 17L17 7M17 7H7M17 7v10"
                            />
                          </svg>
                        </div>
                      </div>
                    </div>
                  </a>
                </article>
        ))
      }
      </div>
    </div> <!-- End Carousel Container -->

    <div class="mt-4 text-center">
      <a
        href="/propiedades"
        class="inline-flex items-center justify-center px-7 py-3 rounded-xl bg-primary text-white font-heading font-semibold tracking-wide transition-all duration-300 hover:bg-deepest hover:shadow-lg hover:-translate-y-0.5"
      >
        Ver el Catálogo Completo
      </a>
    </div>
  </div>
</section>

<style>
  /* Ocultar scrollbar por defecto pero mantener funcionalidad de scroll */
  .scrollbar-hide::-webkit-scrollbar {
      display: none;
  }
  .scrollbar-hide {
      -ms-overflow-style: none;  /* IE and Edge */
      scrollbar-width: none;  /* Firefox */
  }
</style>

<script>
  // Script rápido para botones del carrusel (Client-side)
  document.addEventListener('astro:page-load', () => {
    const slider = document.getElementById('slider');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    if (!slider || !prevBtn || !nextBtn) return;

    // Calcular cuánto deslizar (el ancho de una card + gap)
    const scrollAmount = () => slider.querySelector('article')?.clientWidth || 0;

    prevBtn.addEventListener('click', () => {
      slider.scrollBy({ left: -scrollAmount() - 24, behavior: 'smooth' }); // 24 = aprox gap
    });

    nextBtn.addEventListener('click', () => {
      slider.scrollBy({ left: scrollAmount() + 24, behavior: 'smooth' });
    });

    // Deshabilitar botones en los extremos
    const updateButtons = () => {
      (prevBtn as HTMLButtonElement).disabled = slider.scrollLeft <= 0;
      (nextBtn as HTMLButtonElement).disabled = Math.ceil(slider.scrollLeft + slider.clientWidth) >= slider.scrollWidth;
    };

    slider.addEventListener('scroll', updateButtons, { passive: true });
    
    // Check inicial
    updateButtons();
  });
</script>

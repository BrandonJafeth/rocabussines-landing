---

---

<section class="py-20 bg-gradient-to-b from-white to-light/40 relative overflow-hidden">
  <!-- Glow decorativo de fondo -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-20 -left-20 w-72 h-72 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute -bottom-20 -right-20 w-80 h-80 rounded-full bg-deepest/10 blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold mb-4">
        Solidez que <span class="text-primary">Nos Define</span>
      </h2>
      <div class="w-20 h-1 bg-primary rounded-full mx-auto"></div>
    </div>

    <!-- Mission and Vision Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      <!-- Mission Card -->
      <article
        class="group relative overflow-hidden rounded-2xl border border-primary/25 bg-white p-8 shadow-xl transition-all duration-300 hover:-translate-y-2 hover:border-primary/45 hover:shadow-[0_20px_60px_-20px_rgba(19,64,116,0.55)]"
      >
        <div class="absolute top-0 left-0 h-1.5 w-full bg-gradient-to-r from-deepest via-primary to-mid"></div>

        <div class="flex items-start space-x-4">
          <div class="flex-shrink-0">
            <div
              class="w-14 h-14 rounded-xl flex items-center justify-center bg-gradient-to-br from-deepest to-primary text-white shadow-lg shadow-primary/30 transition-all duration-300 group-hover:scale-110 group-hover:shadow-primary/50"
            >
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>

          <div class="flex-1">
            <h3 class="text-2xl font-heading font-bold tracking-tight text-deepest mb-3">Misión</h3>
            <div class="w-12 h-1 bg-primary rounded-full mb-4 transition-all duration-300 group-hover:w-16"></div>
            <p class="text-deepest/85 font-body leading-relaxed">
              Transformar proyectos en realidades firmes, brindando asesoría integral con
              <strong class="text-deepest">ética, innovación</strong> y
              <strong class="text-deepest">compromiso</strong> inquebrantable.
            </p>
          </div>
        </div>
      </article>

      <!-- Vision Card -->
      <article
        class="group relative overflow-hidden rounded-2xl border border-primary/25 bg-white p-8 shadow-xl transition-all duration-300 hover:-translate-y-2 hover:border-primary/45 hover:shadow-[0_20px_60px_-20px_rgba(19,64,116,0.55)]"
      >
        <div class="absolute top-0 left-0 h-1.5 w-full bg-gradient-to-r from-deepest via-primary to-mid"></div>

        <div class="flex items-start space-x-4">
          <div class="flex-shrink-0">
            <div
              class="w-14 h-14 rounded-xl flex items-center justify-center bg-gradient-to-br from-deepest to-primary text-white shadow-lg shadow-primary/30 transition-all duration-300 group-hover:scale-110 group-hover:shadow-primary/50"
            >
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
            </div>
          </div>

          <div class="flex-1">
            <h3 class="text-2xl font-heading font-bold tracking-tight text-deepest mb-3">Visión</h3>
            <div class="w-12 h-1 bg-primary rounded-full mb-4 transition-all duration-300 group-hover:w-16"></div>
            <p class="text-deepest/85 font-body leading-relaxed">
              Ser la empresa <strong class="text-deepest">sólida y confiable</strong> en asesorías
              inmobiliarias, reconocida por nuestra excelencia y compromiso inquebrantable con cada cliente.
            </p>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /* Subtle animation on scroll */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

---
import SectionSeam from "../../layout/SectionSeam.astro";
const dict = Astro.locals.dict;
---

<section class="py-24 lg:py-32 bg-gradient-to-br from-primary via-deepest to-black relative overflow-hidden">
  <SectionSeam from="#F6F8FB" height="16rem" holdPercent={20} />
  <!-- Minimalist background accent -->
  <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Decorative Header -->
    <div class="flex items-center gap-4 mb-4 lg:mb-6">
      <div class="w-12 h-[1px] bg-mid/50"></div>
      <span class="text-mid font-heading tracking-[0.2em] text-xs uppercase font-medium">{dict.mission.eyebrow}</span>
    </div>

    <!-- Creative Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      
      <!-- Typography Block: Title -->
      <div class="col-span-1 md:col-span-2 mb-4 lg:mb-8">
        <h2 class="text-5xl md:text-6xl lg:text-7xl font-heading font-medium text-white leading-[1.1] tracking-tight max-w-4xl">
          {dict.mission.headingLine1} <br class="hidden sm:block" />
          <span class="italic text-mid font-serif font-light">{dict.mission.headingItalic}</span>
        </h2>
      </div>

      <!-- Misión Card -->
      <article class="bg-white rounded-3xl p-8 sm:p-10 shadow-2xl shadow-deepest/20 group hover:-translate-y-1 transition-transform duration-500">
        <div class="flex items-center gap-5 mb-8">
          <div class="w-14 h-14 rounded-full border border-primary/10 bg-primary/[0.03] flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
          </div>
          <h3 class="text-3xl font-heading font-bold text-deepest tracking-tight">{dict.mission.missionTitle}</h3>
        </div>
        <p class="text-lg text-deepest/75 font-body leading-relaxed" set:html={dict.mission.missionText} />
      </article>

      <!-- Visión Card -->
      <article class="bg-white rounded-3xl p-8 sm:p-10 shadow-2xl shadow-deepest/20 group hover:-translate-y-1 transition-transform duration-500">
        <div class="flex items-center gap-5 mb-8">
          <div class="w-14 h-14 rounded-full border border-primary/10 bg-primary/[0.03] flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </div>
          <h3 class="text-3xl font-heading font-bold text-deepest tracking-tight">{dict.mission.visionTitle}</h3>
        </div>
        <p class="text-lg text-deepest/75 font-body leading-relaxed" set:html={dict.mission.visionText} />
      </article>

    </div>
  </div>
</section>

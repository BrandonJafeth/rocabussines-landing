---
import SectionBlobs from "../../layout/SectionBlobs.astro";
const dict = Astro.locals.dict;
---

<section id="nosotros" class="relative overflow-hidden py-20 bg-white scroll-mt-28">
  <SectionBlobs />
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start lg:items-center"
    >
      <div class="lg:col-span-5 space-y-6 lg:self-center lg:translate-y-4">
        <h2
          class="text-3xl text-center sm:text-start sm:text-4xl lg:text-5xl font-heading font-bold tracking-tight text-deepest leading-tight"
        >
          {dict.about.heading}
          <span class="text-primary">{dict.about.headingHighlight}</span>
        </h2>

        <div
          class="w-20 h-1 items-center bg-primary rounded-full mx-auto sm:mx-0"
        >
        </div>
      </div>

      <div class="lg:col-span-1">
        <div
          class="about-divider hidden lg:block h-full min-h-[260px] w-px mx-auto"
        >
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="space-y-4 text-deepest/80 font-heading">
          <p class="text-lg leading-relaxed" set:html={dict.about.p1} />
          <p class="text-base sm:text-lg leading-relaxed">
            {dict.about.p2}
          </p>
          <p class="text-base sm:text-lg leading-relaxed" set:html={dict.about.p3} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-divider {
    background: linear-gradient(
      to bottom,
      rgba(19, 64, 116, 0.05) 0%,
      rgba(19, 64, 116, 0.25) 50%,
      rgba(19, 64, 116, 0.05) 100%
    );
  }
</style>

---
interface Props {
  variant?: "light" | "dark";
}
const { variant = "light" } = Astro.props;
const lang = Astro.locals.lang ?? "es";

const activeClass = variant === "dark" ? "text-white" : "text-primary";
const inactiveClass =
  variant === "dark" ? "text-white/50 hover:text-white" : "text-deepest/50 hover:text-primary";
const dividerClass = variant === "dark" ? "text-white/30" : "text-deepest/30";
---

<div
  class="flex items-center gap-1 font-heading text-sm select-none"
  role="group"
  aria-label="Language / Idioma"
>
  <a
    href="?lang=es"
    data-astro-reload
    class:list={["px-1 transition-colors", lang === "es" ? `font-bold ${activeClass}` : inactiveClass]}
  >
    ES
  </a>
  <span class={dividerClass} aria-hidden="true">|</span>
  <a
    href="?lang=en"
    data-astro-reload
    class:list={["px-1 transition-colors", lang === "en" ? `font-bold ${activeClass}` : inactiveClass]}
  >
    EN
  </a>
</div>

---
interface Props {
  variant?: "light" | "dark";
}
const { variant = "light" } = Astro.props;
const lang = Astro.locals.lang ?? "es";

const trackClass = variant === "dark" ? "bg-white/15" : "bg-deepest";
const activeClass = "bg-white text-deepest shadow-sm";
const inactiveClass =
  variant === "dark" ? "text-white/60 hover:text-white" : "text-white/50 hover:text-white/85";
---

<div
  class:list={["inline-flex items-center gap-0.5 rounded-full p-1 font-heading", trackClass]}
  role="group"
  aria-label="Language / Idioma"
>
  <a
    href="?lang=es"
    data-astro-reload
    class:list={[
      "rounded-full px-3 py-1 text-xs font-bold tracking-wide transition-colors duration-200",
      lang === "es" ? activeClass : inactiveClass,
    ]}
  >
    ES
  </a>
  <a
    href="?lang=en"
    data-astro-reload
    class:list={[
      "rounded-full px-3 py-1 text-xs font-bold tracking-wide transition-colors duration-200",
      lang === "en" ? activeClass : inactiveClass,
    ]}
  >
    EN
  </a>
</div>

---
interface Props {
  variant?: "light" | "dark" | "glass";
}
const { variant = "light" } = Astro.props;
const lang = Astro.locals.lang ?? "es";

const trackClass =
  variant === "glass" ? "lang-pill-glass" : variant === "dark" ? "bg-white/15" : "bg-deepest";
const activeClass =
  variant === "glass" ? "lang-pill-glass__active" : "bg-white text-deepest shadow-sm";
const inactiveClass =
  variant === "glass"
    ? "text-[#eef4ed]/70 hover:text-[#eef4ed]"
    : variant === "dark"
      ? "text-white/60 hover:text-white"
      : "text-white/50 hover:text-white/85";
---

<div
  class:list={["inline-flex items-center gap-0.5 rounded-full p-1 font-heading", trackClass]}
  role="group"
  aria-label="Language / Idioma"
>
  <a
    href="?lang=es"
    data-astro-reload
    class:list={[
      "rounded-full px-3 py-1 text-xs font-bold tracking-wide transition-colors duration-200",
      lang === "es" ? activeClass : inactiveClass,
    ]}
  >
    ES
  </a>
  <a
    href="?lang=en"
    data-astro-reload
    class:list={[
      "rounded-full px-3 py-1 text-xs font-bold tracking-wide transition-colors duration-200",
      lang === "en" ? activeClass : inactiveClass,
    ]}
  >
    EN
  </a>
</div>

<style>
  .lang-pill-glass {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.06));
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.4), 0 4px 14px rgba(0, 0, 0, 0.25);
  }
  .lang-pill-glass__active {
    background: rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    color: #eef4ed;
  }
</style>

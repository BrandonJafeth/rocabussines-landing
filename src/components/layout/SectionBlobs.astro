---
// Decorative blurred organic blobs for white-background sections.
// Usage: drop as the FIRST child inside a section with class="relative overflow-hidden".
---
<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="section-blob section-blob--1"></div>
  <div class="section-blob section-blob--2"></div>
  <div class="section-blob section-blob--3"></div>
</div>

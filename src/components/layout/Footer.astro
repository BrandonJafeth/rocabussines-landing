---
const quickLinks = [
  { label: "Inicio", href: "/" },
  { label: "Servicios", href: "/servicios" },
  { label: "Propiedades", href: "/propiedades" },
  { label: "Contacto", href: "/contacto" },
];

const serviceItems = [
  "Venta de Propiedades",
  "Venta de Terrenos",
  "Asesoría Inmobiliaria",
  "Administración",
  "Valuación",
];

const socialLinks = [
  { label: "Facebook", href: "#" },
  { label: "Instagram", href: "#" },
  { label: "LinkedIn", href: "#" },
  { label: "X", href: "#" },
];
---

<footer
  id="contacto"
  class="relative overflow-hidden bg-gradient-to-br from-deepest via-primary to-dark text-light"
>
  <div
    class="pointer-events-none absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_12%_30%,rgba(255,255,255,0.3),transparent_35%),radial-gradient(circle_at_88%_78%,rgba(255,255,255,0.22),transparent_30%)]"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="grid grid-cols-2 gap-6 sm:gap-12 lg:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <a href="/" class="inline-flex items-center gap-3 group">
          <img
            src="https://res.cloudinary.com/dxrzwnjee/image/upload/v1771881666/jhznh9nfygztx5q8ry4m.png"
            alt="Roca Business"
            class="h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
          <div>
            <p class="font-heading text-xl font-bold leading-none">
              Roca Business
            </p>
            <p
              class="font-heading text-xs uppercase tracking-[0.18em] text-mid"
            >
              Bienes y raíces
            </p>
          </div>
        </a>

        <p class="mt-5 max-w-xs text-sm leading-7 text-light/75 font-heading">
          Tu socio de confianza en bienes raíces. Construyendo relaciones
          sólidas y patrimonio con visión estratégica.
        </p>

        <div class="mt-6 flex items-center gap-2">
          {
            socialLinks.map((item) => (
              <a
                href={item.href}
                aria-label={item.label}
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-light/20 bg-light/10 text-light transition-all duration-300 hover:-translate-y-0.5 hover:bg-light hover:text-deepest"
              >
                {item.label === "Facebook" && (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                  </svg>
                )}
                {item.label === "Instagram" && (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                  </svg>
                )}
                {item.label === "LinkedIn" && (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                  </svg>
                )}
                {item.label === "X" && (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="font-heading text-2xl font-bold">Enlaces Rápidos</h3>
        <ul class="mt-6 space-y-3">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-heading text-light/80 transition-colors duration-300 hover:text-light"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-heading text-2xl font-bold">Servicios</h3>
        <ul class="mt-6 space-y-3">
          {
            serviceItems.map((service) => (
              <li class="font-heading text-light/80">{service}</li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-heading text-2xl font-bold">Contacto</h3>
        <ul class="mt-6 space-y-4 text-light/80 font-heading">
          <li class="flex items-start gap-3">
            <svg
              class="h-5 w-5 mt-0.5 text-mid"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 21s-7-4.35-7-11a7 7 0 1114 0c0 6.65-7 11-7 11z"></path>
              <circle cx="12" cy="10" r="2.5" stroke-width="2"></circle>
            </svg>
            <span>Liberia, Guanacaste, Costa Rica</span>
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="h-5 w-5 mt-0.5 text-mid"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3l2 5-2 1a16 16 0 007 7l1-2 5 2v3a2 2 0 01-2 2h-1C9.82 21 3 14.18 3 6V5z"
              ></path>
            </svg>
            <span>+506 0000-0000</span>
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="h-5 w-5 mt-0.5 text-mid"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16v12H4z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 8l8 6 8-6"></path>
            </svg>
            <span>contacto@rocabusiness.com</span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 pt-6 border-t border-light/15 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm font-heading text-light/65">
        © {new Date().getFullYear()} Roca Business. Todos los derechos reservados.
      </p>

      <a
        href="https://www.instagram.com/one.out_/"
        class="inline-flex items-center gap-2 text-sm font-heading text-light/70"
      >
        <img
          src="https://res.cloudinary.com/dxrzwnjee/image/upload/v1771954550/0241f761-da98-4ff8-ab80-3faa665f3a00.png"
          class="h-8 w-8"
          alt=""
        />

        Desarrollado por One Out
      </a>
    </div>
  </div>
</footer>

---
import { ViewTransitions } from "astro:transitions";
import "@fontsource/antic-didone";
import "../styles/global.css";
import Footer from "../components/layout/Footer.astro";
import FloatingButtons from "../components/react/FloatingButtons";
import Navbar from "../components/layout/Navbar.astro";

interface Props {
  title?: string;
  description?: string;
}

const lang = Astro.locals.lang ?? "es";
const dict = Astro.locals.dict;

const {
  title = dict.seo.home.title,
  description = dict.seo.home.description,
} = Astro.props;

// Construimos la URL canónica
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://www.rocabusiness.net/");
const shareImage = "https://res.cloudinary.com/dxrzwnjee/image/upload/v1771881666/jhznh9nfygztx5q8ry4m.png";
const ogLocale = lang === "en" ? "en_US" : "es_CR";
const orgDescription =
  lang === "en"
    ? "Firm specialized in real estate and comprehensive advisory in Guanacaste and throughout Costa Rica. Buying, selling, renting, appraisal, and property management."
    : "Firma especializada en bienes raíces y asesoría integral en Guanacaste y toda Costa Rica. Compra, venta, alquiler, valuación y administración de propiedades.";
const websiteDescription =
  lang === "en"
    ? "Real estate and property advisory in Guanacaste and Costa Rica"
    : "Bienes raíces y asesoría inmobiliaria en Guanacaste y Costa Rica";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Real Estate Guanacaste, Propiedades en Guanacaste, Bienes Raíces Costa Rica, Venta de casas Liberia, Fincas en Costa Rica, Lotes en venta Guanacaste, Asesoría Inmobiliaria Costa Rica, Compra venta alquiler, Administración de propiedades, Valuación inmobiliaria, Roca Business" />
    <meta name="author" content="Roca Business" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <!-- Geo Tags (Local SEO) -->
    <meta name="geo.region" content="CR-G" />
    <meta name="geo.placename" content="Liberia" />
    <meta name="geo.position" content="10.6333;-85.4333" />
    <meta name="ICBM" content="10.6333, -85.4333" />
    
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Redes Sociales Facebook & LinkedIn -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Roca Business" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Roca Business Logo" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" />
    <!-- Theme Color para móviles -->
    <meta name="theme-color" content="#0B2545" />
    
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />

    <!-- Schema.org JSON-LD: RealEstateAgent -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "RealEstateAgent",
        "name": "Roca Business",
        "description": orgDescription,
        "image": shareImage,
        "@id": "https://www.rocabusiness.net/#organization",
        "url": "https://www.rocabusiness.net/",
        "telephone": "+50670442878",
        "email": "asesorias@rocabusiness.net",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Liberia",
          "addressRegion": "Guanacaste",
          "postalCode": "50101",
          "addressCountry": "CR"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 10.63333,
          "longitude": -85.43333
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "08:00",
            "closes": "17:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Saturday"],
            "opens": "09:00",
            "closes": "14:00"
          }
        ],
        "areaServed": [
          { "@type": "State", "name": "Guanacaste" },
          { "@type": "City", "name": "Liberia" },
          { "@type": "City", "name": "Bagaces" },
          { "@type": "City", "name": "Santa Cruz" },
          { "@type": "Place", "name": "Tempate" }
        ],
        "sameAs": [
          "https://www.instagram.com/roca_business_/",
          "https://www.facebook.com/profile.php?id=61576995422413",
          "https://share.google/sSF0nOELzP01Vc4l4"
        ],
        "priceRange": "$$$",
        "currenciesAccepted": "CRC, USD"
      })}
    />
    <!-- Schema.org JSON-LD: WebSite -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.rocabusiness.net/#website",
        "url": "https://www.rocabusiness.net/",
        "name": "Roca Business",
        "description": websiteDescription,
        "inLanguage": lang,
        "publisher": {
          "@id": "https://www.rocabusiness.net/#organization"
        }
      })}
    />
  </head>
  <body>
    <Navbar />
    <!-- Floating Buttons (WhatsApp y Scroll to Top) -->
    <FloatingButtons client:load lang={lang} />

    <div class="cursor-follower" aria-hidden="true">
      <div class="cursor-follower__dot"></div>
      <div class="cursor-follower__ring"></div>
    </div>

    <slot />
    <Footer />

    <script is:inline>
      // Función para inicializar el cursor
      function initCursor() {
        const mediaFinePointer = window.matchMedia("(pointer: fine)").matches;
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        if (!mediaFinePointer || reducedMotion) return null;

        const follower = document.querySelector(".cursor-follower");
        const dot = document.querySelector(".cursor-follower__dot");
        const ring = document.querySelector(".cursor-follower__ring");

        if (!follower || !dot || !ring) return null;

        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let ringX = mouseX;
        let ringY = mouseY;
        let active = false;
        let animationId = null;

        const interactiveSelector =
          'a, button, input, textarea, select, [role="button"]';

        const onMove = (event) => {
          mouseX = event.clientX;
          mouseY = event.clientY;

          if (!active) {
            active = true;
            follower.classList.add("is-active");
          }

          const target = event.target;
          const isInteractive =
            target instanceof Element && target.closest(interactiveSelector);
          follower.classList.toggle("is-interactive", Boolean(isInteractive));

          dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
        };

        const onLeave = () => {
          active = false;
          follower.classList.remove("is-active", "is-interactive");
        };

        const animate = () => {
          ringX += (mouseX - ringX) * 0.15;
          ringY += (mouseY - ringY) * 0.15;
          ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
          animationId = requestAnimationFrame(animate);
        };

        window.addEventListener("mousemove", onMove, { passive: true });
        window.addEventListener("mouseout", onLeave, { passive: true });
        window.addEventListener("blur", onLeave);
        animationId = requestAnimationFrame(animate);

        // Retornar función de limpieza
        return () => {
          window.removeEventListener("mousemove", onMove);
          window.removeEventListener("mouseout", onLeave);
          window.removeEventListener("blur", onLeave);
          if (animationId) cancelAnimationFrame(animationId);
          follower.classList.remove("is-active", "is-interactive");
        };
      }

      // Variable global para almacenar la función de limpieza
      let cleanupCursor = null;

      // Inicializar en carga inicial
      document.addEventListener("DOMContentLoaded", () => {
        cleanupCursor = initCursor();
      });

      // Reinicializar después de cada navegación con ViewTransitions
      document.addEventListener("astro:after-swap", () => {
        // Limpiar cursor anterior si existe
        if (cleanupCursor) {
          cleanupCursor();
        }
        // Inicializar nuevo cursor
        cleanupCursor = initCursor();
      });

      // Lluvia de partículas doradas al hacer clic
      const starRain = (x, y) => {
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reducedMotion) return;

        const count = 22;
        for (let i = 0; i < count; i++) {
          const s = document.createElement("div");
          s.className = "star-particle";
          const size = 3 + Math.random() * 4;
          s.style.width = size + "px";
          s.style.height = size + "px";
          s.style.left = x + (Math.random() - 0.5) * 40 + "px";
          s.style.top = y + "px";
          const dx = (Math.random() - 0.5) * 14;
          const dy = 260 + Math.random() * 220;
          s.style.setProperty("--dx", dx + "px");
          s.style.setProperty("--dy", dy + "px");
          s.style.animationDelay = Math.random() * 0.15 + "s";
          s.style.animation = `starfall ${0.9 + Math.random() * 0.6}s cubic-bezier(.4,0,.7,1) forwards`;
          document.body.appendChild(s);
          setTimeout(() => s.remove(), 1800);
        }
      };

      // Capture phase, on document: fires before any element (button, link, card)
      // can call stopPropagation() to swallow the click during the bubble phase.
      document.addEventListener(
        "click",
        (e) => starRain(e.clientX, e.clientY),
        true
      );
    </script>
  </body>
</html>

<style is:global>
  /* TODO: Self-host Sansation font - place .woff2 files in public/fonts/ */
  /* For now using system fonts as fallback */
  @font-face {
    font-family: "Sansation";
    src: local("Arial"), local("Helvetica");
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: "Sansation";
    src: local("Arial"), local("Helvetica");
    font-weight: 700;
    font-display: swap;
  }

  :root {
    /* Paleta Principal */
    --color-deepest: #0b2545;
    --color-primary: #134074;
    --color-dark: #13315c;
    --color-mid: #8da9c4;
    --color-light: #ffffff;

    /* Semántica de uso */
    --background: #ffffff;
    --surface: #eef4ed;
    --surface-dark: #134074;
    --text-main: #0b2545;
    --text-on-dark: #eef4ed;
    --text-muted: #8da9c4;
    --border: #8da9c4;
    --success: #2d9e6b;
    --error: #d64045;

    /* Tipografía */
    --font-heading: "Sansation", sans-serif;
    --font-body: "Sansation", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    background: var(--background);
    color: var(--text-main);
    font-family: var(--font-body);
    line-height: 1.6;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading);
    line-height: 1.2;
    margin: 0;
  }

  p {
    margin: 0;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  .cursor-follower {
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .cursor-follower.is-active {
    opacity: 1;
  }

  .cursor-follower__dot,
  .cursor-follower__ring {
    position: fixed;
    left: 0;
    top: 0;
    translate: -50% -50%;
    border-radius: 999px;
    pointer-events: none;
    will-change: transform;
  }

  .cursor-follower__dot {
    width: 8px;
    height: 8px;
    background: rgba(11, 37, 69, 0.95);
    box-shadow: 0 0 16px rgba(11, 37, 69, 0.25);
  }

  .cursor-follower__ring {
    width: 34px;
    height: 34px;
    border: 1.5px solid rgba(19, 64, 116, 0.4);
    background: rgba(19, 64, 116, 0.08);
    backdrop-filter: blur(1px);
    transition:
      width 180ms ease,
      height 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .cursor-follower.is-interactive .cursor-follower__ring {
    width: 54px;
    height: 54px;
    border-color: rgba(19, 64, 116, 0.7);
    background: rgba(19, 64, 116, 0.14);
  }

  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .cursor-follower {
      display: none;
    }
  }

  /* Decorative diagonal line pattern for white-background sections (see SectionBlobs.astro).
     "Opción D — Diagonal amplia": primary blue at 3.2% opacity, 45°, every 52px. */
  .section-blob-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      135deg,
      rgba(19, 64, 116, 0.065) 0px,
      rgba(19, 64, 116, 0.065) 1px,
      transparent 1px,
      transparent 52px
    );
  }

  /* Click effect: falling golden particles (site-wide).
     z-index must beat every other fixed overlay on the page -- notably
     .page-loader (z-index 9999, opaque, covers the screen for ~2.6s after
     load) and .cursor-follower (9998). A click during that loader window
     used to create particles correctly but they rendered BEHIND it and
     were invisible -- that's why the effect looked random by location when
     it was actually about timing (right after a fresh page load). */
  .star-particle {
    position: fixed;
    z-index: 999999;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(circle, #fff7e0 0%, #c9a468 60%, transparent 100%);
    box-shadow: 0 0 6px 1px rgba(201, 164, 104, 0.6);
  }
  @keyframes starfall {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 1;
    }
    100% {
      transform: translate(var(--dx), var(--dy)) scale(0.3);
      opacity: 0;
    }
  }

  /* .glow-card / .card-inner: the two-layer split from the card markup is
     kept (harmless, avoids re-touching 6 templates), but the glow itself
     was removed -- it read as a heavy orange smear in production, not the
     subtle halo intended. */
</style>

---
import { ViewTransitions } from "astro:transitions";
import "@fontsource/antic-didone";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Propiedades en Guanacaste | Roca Business",
  description = "Casas, fincas y lotes en Costa Rica. Amplio catálogo disponible. Contáctanos hoy.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />

    <!-- Schema.org JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "RealEstateAgent",
        name: "Roca Business",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Liberia",
          addressRegion: "Guanacaste",
          addressCountry: "CR",
        },
        url: "https://rocabusiness.com",
      })}
    />
  </head>
  <body>
    <div class="cursor-follower" aria-hidden="true">
      <div class="cursor-follower__dot"></div>
      <div class="cursor-follower__ring"></div>
    </div>
    <slot />

    <script is:inline>
      (() => {
        const mediaFinePointer = window.matchMedia("(pointer: fine)").matches;
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        if (!mediaFinePointer || reducedMotion) return;

        const follower = document.querySelector(".cursor-follower");
        const dot = document.querySelector(".cursor-follower__dot");
        const ring = document.querySelector(".cursor-follower__ring");

        if (!follower || !dot || !ring) return;

        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let ringX = mouseX;
        let ringY = mouseY;
        let active = false;

        const interactiveSelector =
          'a, button, input, textarea, select, [role="button"]';

        const onMove = (event) => {
          mouseX = event.clientX;
          mouseY = event.clientY;

          if (!active) {
            active = true;
            follower.classList.add("is-active");
          }

          const target = event.target;
          const isInteractive =
            target instanceof Element && target.closest(interactiveSelector);
          follower.classList.toggle("is-interactive", Boolean(isInteractive));

          dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
        };

        const onLeave = () => {
          active = false;
          follower.classList.remove("is-active", "is-interactive");
        };

        const animate = () => {
          ringX += (mouseX - ringX) * 0.15;
          ringY += (mouseY - ringY) * 0.15;
          ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
          requestAnimationFrame(animate);
        };

        window.addEventListener("mousemove", onMove, { passive: true });
        window.addEventListener("mouseout", onLeave, { passive: true });
        window.addEventListener("blur", onLeave);
        requestAnimationFrame(animate);
      })();
    </script>
  </body>
</html>

<style is:global>
  /* TODO: Self-host Sansation font - place .woff2 files in public/fonts/ */
  /* For now using system fonts as fallback */
  @font-face {
    font-family: "Sansation";
    src: local("Arial"), local("Helvetica");
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: "Sansation";
    src: local("Arial"), local("Helvetica");
    font-weight: 700;
    font-display: swap;
  }

  :root {
    /* Paleta Principal */
    --color-deepest: #0b2545;
    --color-primary: #134074;
    --color-dark: #13315c;
    --color-mid: #8da9c4;
    --color-light: #ffffff;

    /* Semántica de uso */
    --background: #ffffff;
    --surface: #eef4ed;
    --surface-dark: #134074;
    --text-main: #0b2545;
    --text-on-dark: #eef4ed;
    --text-muted: #8da9c4;
    --border: #8da9c4;
    --success: #2d9e6b;
    --error: #d64045;

    /* Tipografía */
    --font-heading: "Sansation", sans-serif;
    --font-body: "Sansation", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    background: var(--background);
    color: var(--text-main);
    font-family: var(--font-body);
    line-height: 1.6;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading);
    line-height: 1.2;
    margin: 0;
  }

  p {
    margin: 0;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  .cursor-follower {
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .cursor-follower.is-active {
    opacity: 1;
  }

  .cursor-follower__dot,
  .cursor-follower__ring {
    position: fixed;
    left: 0;
    top: 0;
    translate: -50% -50%;
    border-radius: 999px;
    pointer-events: none;
    will-change: transform;
  }

  .cursor-follower__dot {
    width: 8px;
    height: 8px;
    background: rgba(11, 37, 69, 0.95);
    box-shadow: 0 0 16px rgba(11, 37, 69, 0.25);
  }

  .cursor-follower__ring {
    width: 34px;
    height: 34px;
    border: 1.5px solid rgba(19, 64, 116, 0.4);
    background: rgba(19, 64, 116, 0.08);
    backdrop-filter: blur(1px);
    transition:
      width 180ms ease,
      height 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .cursor-follower.is-interactive .cursor-follower__ring {
    width: 54px;
    height: 54px;
    border-color: rgba(19, 64, 116, 0.7);
    background: rgba(19, 64, 116, 0.14);
  }

  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .cursor-follower {
      display: none;
    }
  }
</style>
